# ==========================================
# Peak1 Backend Environment Configuration Template
# ==========================================

# --- App Settings ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database Connection ---
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/peak1_prod?retryWrites=true&w=majority

# --- Authentication & Pass Security ---
JWT_SECRET=your_jwt_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=8h
QR_SIGNING_SECRET=your_qr_signing_secret_minimum_32_chars

# --- Admin Account Provisioning ---
ADMIN_EMAIL=admin@peak1.app
ADMIN_PASSWORD=Admin@123456

# --- Payment Gateway (Razorpay) ---
PAYMENT_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Automated Email API (Web3Forms) ---
WEB3FORMS_ACCESS_KEY=b89561b0-0eee-43b1-87f5-b23a217eb881
EMAIL_FROM=noreply@peak1.app

# --- Asset Storage ---
STORAGE_PROVIDER=local
UPLOAD_PATH=public/uploads
