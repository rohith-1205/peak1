# ==========================================
# Peak1 Backend Environment Configuration
# ==========================================

# --- App Settings ---
# APP_ENV: 'development' | 'staging' | 'production'
APP_ENV=development
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# --- Database ---
# Staging/Prod: Use separate MongoDB Atlas clusters or databases
MONGO_URI=mongodb://localhost:27017/peak1_dev

# --- Auth ---
# Secret key for JWT generation (must be strong)
JWT_SECRET=super_secret_dev_key_change_me
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=8h
ALLOW_ADMIN_PUBLIC_LOGIN=false

# --- Email ---
# SMTP credentials for sending registration emails
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_user
EMAIL_PASS=your_mailtrap_pass

# --- Payments (Razorpay) ---
PAYMENT_PROVIDER=RAZORPAY
# Staging: use TEST keys. Production: use LIVE keys.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=webhook_secret_placeholder

# --- Storage ---
# 'local' for development, 'cloudinary' for staging/production
STORAGE_PROVIDER=local
UPLOAD_PATH=public/uploads
# Required only if STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- QR Code ---
# Secret for HMAC signing QR payloads
QR_SIGNING_SECRET=qr_signing_secret_dev_key

# --- Admin Seeding ---
ADMIN_EMAIL=admin@peak1.app
ADMIN_NAME=Peak1 Administrator
# Used only when running the seed scripts
SEED_ADMIN_PASSWORD=Admin@123456
SEED_USER_PASSWORD=User@123456
# In production, set FORCE_SEED=true to run the seed script
FORCE_SEED=false
