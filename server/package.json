{
  "name": "peak1-server",
  "version": "1.0.0",
  "description": "Backend REST API for Peak1 Event Platform",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
